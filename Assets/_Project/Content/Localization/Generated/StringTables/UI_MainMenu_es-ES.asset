    m_Metadata:
      m_Items: []
  - m_Id: 195575813
    m_Localized: "Tres ranuras independientes \xB7 recuperaci\xF3n autom\xE1tica
      de copias de seguridad"
    m_Metadata:
      m_Items: []
  - m_Id: 195575814
    m_Localized: "Guardado da\xF1ado sin copia de seguridad v\xE1lida"
    m_Metadata:
      m_Items: []
  - m_Id: 195575815
    m_Localized: "Esto elimina el guardado principal, la copia de seguridad, el progreso
      del tutorial y el registro de guardado autom\xE1tico."
    m_Metadata:
      m_Items: []
  - m_Id: 195575816
    m_Localized: "\xBFEliminar la ranura de guardado?"
    m_Metadata:
      m_Items: []
  - m_Id: 195575817
    m_Localized: "Ranura vac\xEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 195575818
    m_Localized: "Crear una nueva partida reemplazar\xE1 la ranura existente."
    m_Metadata:
      m_Items: []
  - m_Id: 195575819
    m_Localized: "La ranura activa se guarda autom\xE1ticamente una vez tras cerrar
      correctamente una jornada."
    m_Metadata:
      m_Items: []
  - m_Id: 195575820
    m_Localized: "La versi\xF3n v\xE1lida anterior se conserva como copia de seguridad."
    m_Metadata:
      m_Items: []
  - m_Id: 195575821
    m_Localized: 'Intro: activar'
    m_Metadata:
      m_Items: []
  - m_Id: 195575822
    m_Localized: 'Escape: cerrar la capa superior'
    m_Metadata:
      m_Items: []
  - m_Id: 195575823
    m_Localized: "Tab / May\xFAs+Tab: mover el foco"
    m_Metadata:
      m_Items: []
  - m_Id: 195575824
