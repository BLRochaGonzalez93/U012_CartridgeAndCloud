      m_Items: []
  - m_Id: 195575829
    m_Localized: Interfaz de la tienda
    m_Metadata:
      m_Items: []
  - m_Id: 195575830
    m_Localized: "La aplicaci\xF3n se cerrar\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 195575831
    m_Localized: "\xBFSalir de Cartridge & Cloud?"
    m_Metadata:
      m_Items: []
  - m_Id: 195575832
    m_Localized: "\xB7 Recuperada desde la copia de seguridad"
    m_Metadata:
      m_Items: []
  - m_Id: 195575833
    m_Localized: "Se eliminar\xE1n la partida existente y el progreso del tutorial."
    m_Metadata:
      m_Items: []
