{
  "schemaVersion": 1,
  "unityVersion": "6000.3.18f1",
  "globalPlayerSettings": {
    "defaultWidth": 1920,
    "defaultHeight": 1080,
    "fullscreenMode": "FullScreenWindow",
    "resizableWindow": true,
    "runInBackground": false,
    "usePlayerLog": true,
