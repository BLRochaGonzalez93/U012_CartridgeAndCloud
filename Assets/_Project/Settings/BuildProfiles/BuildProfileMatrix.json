      "scriptDebugging": false,
      "waitForManagedDebugger": false,
      "copyPdbFiles": false,
      "compression": "LZ4",
      "scriptingDefines": [
        "CC_BUILD_DEVELOPMENT"
      ],
      "scenes": [
        "Assets/_Project/Scenes/Production/Bootstrap.unity",
        "Assets/_Project/Scenes/Production/MainMenu.unity",
        "Assets/_Project/Scenes/Production/StoreInitial.unity",
        "Assets/_Project/Scenes/Test/TestLab.unity"
      ],
      "buildOutput": "Builds/Windows_Development/CartridgeAndCloud_Development.exe"
    },
    {
      "name": "Windows_QA",
      "purpose": "Formal internal QA and regression campaigns with TestLab available.",
      "assetPath": "Assets/_Project/Settings/BuildProfiles/Windows_QA.asset",
      "developmentBuild": true,
      "testLabIncluded": true,
      "diagnosticData": "Disabled",
      "autoconnectProfiler": false,
      "deepProfiling": false,
      "scriptDebugging": false,
      "waitForManagedDebugger": false,
      "copyPdbFiles": false,
      "compression": "LZ4",
      "scriptingDefines": [
        "CC_BUILD_QA"
      ],
      "scenes": [
        "Assets/_Project/Scenes/Production/Bootstrap.unity",
        "Assets/_Project/Scenes/Production/MainMenu.unity",
        "Assets/_Project/Scenes/Production/StoreInitial.unity",
        "Assets/_Project/Scenes/Test/TestLab.unity"
      ],
      "buildOutput": "Builds/Windows_QA/CartridgeAndCloud_QA.exe"
    },
    {
      "name": "Windows_H6_Candidate",
      "purpose": "Release-like H6 candidate profile prepared for Phase 7.",
      "assetPath": "Assets/_Project/Settings/BuildProfiles/Windows_H6_Candidate.asset",
      "developmentBuild": false,
      "testLabIncluded": false,
      "diagnosticData": "Disabled",
      "autoconnectProfiler": false,
      "deepProfiling": false,
      "scriptDebugging": false,
